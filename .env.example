# Sichere Nacht: Nicht sensible Angaben kommen in Vercel Environment Variables.
# Zahlungsfreigabe nur nach Prüfung von Versand, Steuern, Rechtstexten und Tests.
NEXT_PUBLIC_SITE_URL=https://sichere-nacht.de
NEXT_PUBLIC_CHECKOUT_ENABLED=false
CHECKOUT_ENABLED=false
# Preview only: allow checkout with sk_test_..., never enable in production
CHECKOUT_TEST_ENABLED=false
PAYMENTS_LIVE_APPROVED=false
# Test: sk_test_... und pk_test_..., später Live: sk_live_... und pk_live_...
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Tax ist aktiviert, Bruttopreise werden als inklusiv übertragen.
# Versandpauschale Deutschland: 990 Cent brutto im Checkout-Code.
# Österreich ist in Checkout Studio zugelassen; Konditionen vor Livegang prüfen.
# Bis zur Einrichtung der Partnerdatenbank: Kommagetrennte freigegebene VP-IDs.
VALID_PARTNER_IDS=
# Kontaktformular via Resend: Domain und Absender vorher verifizieren.
CONTACT_RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
